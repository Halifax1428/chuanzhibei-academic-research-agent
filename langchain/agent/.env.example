# 复制本文件为 .env，再填写真实模型配置。
# 不要把真实 API Key 提交到 Git 或发到聊天中。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
TRACK_REFRESH_INTERVAL_SECONDS=86400
TESSERACT_LANGUAGES=eng+chi_sim
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_DATA_DIR=C:\Users\你的用户名\AppData\Local\Tesseract-OCR\tessdata

# 使用 OpenAI 兼容协议的其他服务时，填写其 /v1 地址，例如 https://xxx/v1。
# 当前工程不内置假模型；未配置时，模型相关接口会直接提示补充 API。
